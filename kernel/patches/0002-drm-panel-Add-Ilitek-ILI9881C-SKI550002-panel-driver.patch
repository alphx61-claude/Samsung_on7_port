+struct ili9881c_ski550002 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator_bulk_data *supplies;
+	struct gpio_desc *reset_gpio;
+};
+
+static const struct regulator_bulk_data ili9881c_ski550002_supplies[] = {
+	{ .supply = "vddio" },	/* 1.8V logic */
+	{ .supply = "vdd" },	/* 2.1V analog */
+	{ .supply = "vsp" },	/* +5.5V, LM3632 LDO */
+	{ .supply = "vsn" },	/* -5.5V, LM3632 LDO */
+};
+
+static inline
+struct ili9881c_ski550002 *to_ili9881c_ski550002(struct drm_panel *panel)
+{
+	return container_of(panel, struct ili9881c_ski550002, panel);
+}
+
+static void ili9881c_ski550002_reset(struct ili9881c_ski550002 *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(20);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(20);
+}
