 .../panel/panel-samsung-ili9881c-ski550002.c  | 1223 +++++++++++++++++
 1 file changed, 1223 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-samsung-ili9881c-ski550002.c

diff --git a/drivers/gpu/drm/panel/panel-samsung-ili9881c-ski550002.c b/drivers/gpu/drm/panel/panel-samsung-ili9881c-ski550002.c
