From 62a2df0cd7b80fa7282fb3ccf7c6a95e1aa274d3 Mon Sep 17 00:00:00 2001
From: alphx61-claude <taranrajput11@gmail.com>
Date: Sat, 12 Sep 2026 08:58:02 +0000
Subject: [PATCH 1004/1004] arm64: dts: qcom: msm8916-samsung-on7: Add display
 and touchscreen

The On7 device tree had no display nodes at all, so the device booted
headless: everything else came up, but the panel was never driven.

Add the MDSS/DSI setup, the panel, the LM3632 that supplies both the
+-5.5V panel bias and the backlight, the GPIO16 LCD power gate, and the
Zinitix touchscreen.

The On7 ships one of two panels. The default compatible selects the
S6D7AA0X62; lk2nd detects which panel is actually installed and replaces
it via the "samsung,on7-panel" fallback compatible.
Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WBT8fxGbtA4EKiL94VBvk2
---
 .../boot/dts/qcom/msm8916-samsung-on7.dts     | 202 ++++++++++++++++++
 1 file changed, 202 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8916-samsung-on7.dts b/arch/arm64/boot/dts/qcom/msm8916-samsung-on7.dts
index 6d5e48336..2df714c20 100644
--- a/arch/arm64/boot/dts/qcom/msm8916-samsung-on7.dts
+++ b/arch/arm64/boot/dts/qcom/msm8916-samsung-on7.dts
@@ -50,6 +50,92 @@ home-button {
 		};
 	};
 
+	reg_lcd_vdd: regulator-lcd-vdd {
+		compatible = "regulator-fixed";
+		regulator-name = "lcd_vdd";
+		regulator-min-microvolt = <2100000>;
+		regulator-max-microvolt = <2100000>;
+
+		gpio = <&tlmm 16 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		vin-supply = <&pm8916_s4>;
+
+		pinctrl-0 = <&lcd_en_default>;
+		pinctrl-names = "default";
+	};
+
+	reg_vdd_tsp: regulator-vdd-tsp {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd_tsp";
+		regulator-min-microvolt = <3000000>;
+		regulator-max-microvolt = <3000000>;
+
+		gpio = <&tlmm 8 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		pinctrl-0 = <&tsp_en_default>;
+		pinctrl-names = "default";
+	};
+
+	i2c-backlight {
+		compatible = "i2c-gpio";
+		sda-gpios = <&tlmm 101 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&tlmm 102 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
+
+		pinctrl-0 = <&bl_i2c_default>;
+		pinctrl-names = "default";
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		backlight_ic: backlight@11 {
+			compatible = "ti,lm3632";
+			reg = <0x11>;
+
+			/* HWEN */
+			enable-gpios = <&tlmm 98 GPIO_ACTIVE_HIGH>;
+
+			pinctrl-0 = <&bl_en_default>;
+			pinctrl-names = "default";
+
+			regulators {
+				compatible = "ti,lm363x-regulator";
+
+				/* ENP, ENN */
+				enable-gpios = <&tlmm 97 GPIO_ACTIVE_HIGH>,
+					       <&tlmm 120 GPIO_ACTIVE_HIGH>;
+
+				vboost {
+					regulator-name = "lcd_boost";
+					regulator-min-microvolt = <6000000>;
+					regulator-max-microvolt = <6000000>;
+					regulator-always-on;
+				};
+
+				lm3632_vsp: vpos {
+					regulator-name = "lcd_vsp";
+					regulator-min-microvolt = <5500000>;
+					regulator-max-microvolt = <5500000>;
+				};
+
+				lm3632_vsn: vneg {
+					regulator-name = "lcd_vsn";
+					regulator-min-microvolt = <5500000>;
+					regulator-max-microvolt = <5500000>;
+				};
+			};
+
+			backlight: backlight {
+				compatible = "ti,lm3632-backlight";
+
+				lcd {
+					led-sources = <0 1>;
+				};
+			};
+		};
+	};
+
 	i2c-muic {
 		compatible = "i2c-gpio";
 		sda-gpios = <&tlmm 105 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
@@ -78,6 +164,66 @@ &blsp_uart2 {
 	status = "okay";
 };
 
+&blsp_i2c5 {
+	status = "okay";
+
+	touchscreen@20 {
+		compatible = "zinitix,bt548";
+		reg = <0x20>;
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <13 IRQ_TYPE_EDGE_FALLING>;
+
+		touchscreen-size-x = <720>;
+		touchscreen-size-y = <1280>;
+
+		vcca-supply = <&reg_vdd_tsp>;
+		vdd-supply = <&pm8916_l6>;
+
+		pinctrl-0 = <&tsp_int_default>;
+		pinctrl-names = "default";
+	};
+};
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	pinctrl-0 = <&mdss_default>;
+	pinctrl-1 = <&mdss_sleep>;
+	pinctrl-names = "default", "sleep";
+
+	/*
+	 * The On7 ships with one of two different panels. lk2nd detects which
+	 * one is installed and replaces the compatible below accordingly; the
+	 * S6D7AA0X62 is kept as the default for the case where it does not.
+	 */
+	panel: panel@0 {
+		compatible = "samsung,s6d7aa0x62-bv050hdm", "samsung,on7-panel";
+		reg = <0>;
+
+		vddio-supply = <&pm8916_l5>;
+		vdd-supply = <&reg_lcd_vdd>;
+		vsp-supply = <&lm3632_vsp>;
+		vsn-supply = <&lm3632_vsn>;
+
+		reset-gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
+		backlight = <&backlight>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	data-lanes = <0 1 2 3>;
+	remote-endpoint = <&panel_in>;
+};
+
 &pm8916_resin {
 	linux,code = <KEY_VOLUMEDOWN>;
 	status = "okay";
@@ -134,6 +280,46 @@ gpio_keys_default: gpio-keys-default-state {
 		bias-pull-up;
 	};
 
+	bl_en_default: bl-en-default-state {
+		pins = "gpio97", "gpio98", "gpio120";
+		function = "gpio";
+
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	bl_i2c_default: bl-i2c-default-state {
+		pins = "gpio101", "gpio102";
+		function = "gpio";
+
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	lcd_en_default: lcd-en-default-state {
+		pins = "gpio16";
+		function = "gpio";
+
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	mdss_default: mdss-default-state {
+		pins = "gpio25";
+		function = "gpio";
+
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	mdss_sleep: mdss-sleep-state {
+		pins = "gpio25";
+		function = "gpio";
+
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
 	muic_i2c_default: muic-i2c-default-state {
 		pins = "gpio105", "gpio106";
 		function = "gpio";
@@ -148,6 +334,22 @@ muic_int_default: muic-int-default-state {
 		bias-disable;
 	};
 
+	tsp_en_default: tsp-en-default-state {
+		pins = "gpio8";
+		function = "gpio";
+
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	tsp_int_default: tsp-int-default-state {
+		pins = "gpio13";
+		function = "gpio";
+
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	sdc2_cd_default: sdc2-cd-default-state {
 		pins = "gpio38";
 		function = "gpio";
